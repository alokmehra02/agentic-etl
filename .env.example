# Database (local Docker default)
DATABASE_URL=postgresql+psycopg://cc:cc@localhost:5432/content_creator

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Storage for uploaded ZIPs and raw artifacts
STORAGE_PATH=./storage

# Optional: LLM for Engineer agent (works without — uses rule-based plans)
OPENAI_API_KEY=

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=content-creator-etl
